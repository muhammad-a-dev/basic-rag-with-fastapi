# Copy to .env and fill in real values. Never commit .env.

# Required for Hugging Face Inference embeddings (BAAI/bge-small-en-v1.5 by default)
HUGGINGFACE_API_KEY=

# Required for the Groq-hosted chat model used by LangChain init_chat_model
GROQ_API_KEY=

# Optional overrides
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
LLM_MODEL_NAME=groq:openai/gpt-oss-120b
CHROMA_PERSIST_DIRECTORY=chroma_db
TEMP_UPLOAD_DIR=temp
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_K=3
RETRIEVER_SCORE_THRESHOLD=0.5
LOG_LEVEL=INFO
